# Maestro Cafe backend environment variables
# All values are placeholders - set real values via environment variables (e.g., Vercel dashboard)
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=your_admin_email@example.com
# SMTP Configuration (for sending reservation/contact emails)
# For Gmail: use an App Password if 2FA is enabled, or enable "Less secure app access"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_or_email_password
SMTP_FROM=Maestro Cafe <noreply@maestrocafe.com>
FOODPANDA_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
FRONTEND_URL=
CORS_ORIGIN=
